#!/usr/bin/env bash
# Launch the regular n-gon construction app: start the local server (using the bundled
# venv interpreter) and open it in the default browser.  Usage: ./run_linux_amd64 [PORT]
# If the chosen port is busy, the next free port (up to +50) is used automatically.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT="${1:-8000}"
PY="$DIR/venv_linux_amd64/bin/python"

if [ ! -x "$PY" ]; then
  echo "找不到虚拟环境解释器：$PY" >&2
  echo "请先创建：python3 -m venv --copies \"$DIR/venv_linux_amd64\" \\" >&2
  echo "          && \"$DIR/venv_linux_amd64/bin/pip\" install -r \"$DIR/requirements.txt\"" >&2
  exit 1
fi

# 从请求的端口开始向上找第一个空闲端口（最多尝试 50 个），绑定 127.0.0.1（server.py 默认地址）
WANTED="$PORT"
LIMIT=$((WANTED + 50)); [ "$LIMIT" -gt 65535 ] && LIMIT=65535
PORT=""
for p in $(seq "$WANTED" "$LIMIT"); do
  if "$PY" -c "import socket,sys
s=socket.socket()
try:
    s.bind(('127.0.0.1', $p)); s.close(); sys.exit(0)
except OSError:
    sys.exit(1)" 2>/dev/null; then
    PORT="$p"; break
  fi
done
if [ -z "$PORT" ]; then
  echo "找不到空闲端口（已尝试 $WANTED 到 $LIMIT）。请关闭占用端口的程序，或指定别的端口：./run_linux_amd64 9000" >&2
  exit 1
fi
if [ "$PORT" != "$WANTED" ]; then
  echo "端口 $WANTED 已被占用，自动改用 $PORT。"
fi
URL="http://127.0.0.1:${PORT}/"

echo "启动服务器：$URL  （按 Ctrl-C 停止）"
"$PY" "$DIR/server.py" --port "$PORT" &
SRV=$!
trap 'kill "$SRV" 2>/dev/null || true' EXIT INT TERM

# 等待端口就绪后再打开浏览器（用 venv 的 python 探测，无需 curl）
for _ in $(seq 1 50); do
  if "$PY" -c "import socket,sys; s=socket.socket(); s.settimeout(0.2); \
sys.exit(0 if s.connect_ex(('127.0.0.1',${PORT}))==0 else 1)" 2>/dev/null; then
    break
  fi
  sleep 0.1
done

if command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$URL" >/dev/null 2>&1 || true
elif command -v gio >/dev/null 2>&1; then
  gio open "$URL" >/dev/null 2>&1 || true
else
  echo "请在浏览器打开：$URL"
fi

wait "$SRV"
